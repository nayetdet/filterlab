{
  "name": "filterlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier . --write",
    "lint": "oxlint --deny-warnings",
    "check": "prettier . --check && oxlint --deny-warnings && stylelint --max-warnings 0 \"**/*.css\" && knip --no-progress --include files,dependencies && bun run build",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "lint-staged": {
    "*.{css,js,mjs,ts,tsx,json,yaml,yml,md}": "prettier --write",
    "*.{js,mjs,ts,tsx}": "oxlint --fix --no-error-on-unmatched-pattern"
  }
}
